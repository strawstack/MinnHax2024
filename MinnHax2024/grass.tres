code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2 : source_color;



void fragment() {
// ColorConstant:8
	vec4 n_out8p0 = vec4(0.000000, 0.294622, 0.134755, 1.000000);


	vec3 n_out13p0;
// ColorFunc:13
	{
		vec3 c = vec3(n_out8p0.xyz);
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out13p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:9
	float n_out9p0 = n_out13p0.x;
	float n_out9p1 = n_out13p0.y;
	float n_out9p2 = n_out13p0.z;


// Input:3
	vec2 n_out3p0 = UV;


// FloatConstant:5
	float n_out5p0 = 64.000000;


// VectorOp:4
	vec2 n_out4p0 = n_out3p0 * vec2(n_out5p0);


// VectorFunc:6
	vec2 n_out6p0 = floor(n_out4p0);


// VectorOp:7
	vec2 n_out7p0 = n_out6p0 / vec2(n_out5p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out7p0);


// FloatOp:14
	float n_in14p1 = 0.50000;
	float n_out14p0 = n_out2p0.x * n_in14p1;


// FloatOp:12
	float n_out12p0 = n_out9p2 + n_out14p0;


// VectorCompose:11
	vec3 n_out11p0 = vec3(n_out9p0, n_out9p1, n_out12p0);


	vec3 n_out10p0;
// ColorFunc:10
	{
		vec3 c = n_out11p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out10p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Output:0
	ALBEDO = n_out10p0;


}
"
