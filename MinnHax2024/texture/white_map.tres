code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2 : source_color;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// ColorConstant:16
	vec4 n_out16p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


	vec3 n_out17p0;
// ColorFunc:17
	{
		vec3 c = vec3(n_out16p0.xyz);
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out17p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:3
	float n_out3p0 = n_out17p0.x;
	float n_out3p1 = n_out17p0.y;
	float n_out3p2 = n_out17p0.z;


// FloatOp:7
	float n_in7p1 = 10.00000;
	float n_out7p0 = n_out2p0.x / n_in7p1;


// FloatOp:8
	float n_in8p1 = 0.01000;
	float n_out8p0 = n_out7p0 - n_in8p1;


// FloatOp:6
	float n_out6p0 = n_out3p2 + n_out8p0;


// VectorCompose:5
	vec3 n_out5p0 = vec3(n_out3p0, n_out3p1, n_out6p0);


	vec3 n_out4p0;
// ColorFunc:4
	{
		vec3 c = n_out5p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out4p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


	vec3 n_out15p0;
// ColorFunc:15
	{
		vec3 c = n_out4p0;
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out15p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:11
	float n_out11p0 = n_out15p0.x;
	float n_out11p1 = n_out15p0.y;
	float n_out11p2 = n_out15p0.z;


// FloatOp:14
	float n_in14p1 = 0.80000;
	float n_out14p0 = n_out11p2 + n_in14p1;


// VectorCompose:13
	vec3 n_out13p0 = vec3(n_out11p0, n_out11p1, n_out14p0);


	vec3 n_out12p0;
// ColorFunc:12
	{
		vec3 c = n_out13p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out12p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


	vec3 n_out9p0;
// If:9
	float n_in9p1 = 0.50000;
	float n_in9p2 = 0.01000;
	if(abs(n_out2p0.x - n_in9p1) < n_in9p2)
	{
		n_out9p0 = n_out12p0;
	}
	else if(n_out2p0.x < n_in9p1)
	{
		n_out9p0 = n_out4p0;
	}
	else
	{
		n_out9p0 = n_out4p0;
	}


	vec3 n_out10p0;
// If:10
	float n_in10p1 = 0.50000;
	float n_in10p2 = 0.01000;
	vec3 n_in10p4 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in10p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out2p0.x - n_in10p1) < n_in10p2)
	{
		n_out10p0 = n_out12p0;
	}
	else if(n_out2p0.x < n_in10p1)
	{
		n_out10p0 = n_in10p5;
	}
	else
	{
		n_out10p0 = n_in10p4;
	}


// Output:0
	ALBEDO = n_out9p0;
	EMISSION = n_out10p0;


}
