code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_8 : source_color;



void fragment() {
// ColorConstant:2
	vec4 n_out2p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


	vec3 n_out7p0;
// ColorFunc:7
	{
		vec3 c = vec3(n_out2p0.xyz);
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out7p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:3
	float n_out3p0 = n_out7p0.x;
	float n_out3p1 = n_out7p0.y;
	float n_out3p2 = n_out7p0.z;


// Input:11
	vec2 n_out11p0 = UV;


// MultiplyAdd:15
	vec2 n_in15p1 = vec2(0.50000, 0.50000);
	vec2 n_in15p2 = vec2(0.25000, 0.25000);
	vec2 n_out15p0 = (n_out11p0 * n_in15p1) + n_in15p2;


	float n_out10p0;
// SinTIME:10
	float n_in10p0 = 0.10000;
	float n_in10p1 = 0.12500;
	{
		n_out10p0 = n_in10p1 * sin(n_in10p0 * TIME);
	}


// VectorOp:12
	vec2 n_out12p0 = n_out15p0 + vec2(n_out10p0);


// Texture2D:8
	vec4 n_out8p0 = texture(tex_frg_8, n_out12p0);


// MultiplyAdd:9
	float n_in9p1 = 0.50000;
	float n_in9p2 = 0.50000;
	float n_out9p0 = (n_out8p0.x * n_in9p1) + n_in9p2;


// FloatOp:5
	float n_out5p0 = n_out3p2 + n_out9p0;


// VectorCompose:4
	vec3 n_out4p0 = vec3(n_out3p0, n_out3p1, n_out5p0);


	vec3 n_out6p0;
// ColorFunc:6
	{
		vec3 c = n_out4p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out6p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Output:0
	ALBEDO = n_out6p0;


}
"
