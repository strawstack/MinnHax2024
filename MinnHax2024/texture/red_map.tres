code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_3 : source_color;



void fragment() {
// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// ColorConstant:2
	vec4 n_out2p0 = vec4(0.509804, 0.062745, 0.074510, 1.000000);


	vec3 n_out8p0;
// ColorFunc:8
	{
		vec3 c = vec3(n_out2p0.xyz);
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out8p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:4
	float n_out4p0 = n_out8p0.x;
	float n_out4p1 = n_out8p0.y;
	float n_out4p2 = n_out8p0.z;


// FloatOp:9
	float n_in9p1 = 10.00000;
	float n_out9p0 = n_out3p0.x / n_in9p1;


// FloatOp:10
	float n_in10p1 = 0.01000;
	float n_out10p0 = n_out9p0 - n_in10p1;


// FloatOp:7
	float n_out7p0 = n_out4p2 + n_out10p0;


// VectorCompose:6
	vec3 n_out6p0 = vec3(n_out4p0, n_out4p1, n_out7p0);


	vec3 n_out5p0;
// ColorFunc:5
	{
		vec3 c = n_out6p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out5p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


	vec3 n_out17p0;
// ColorFunc:17
	{
		vec3 c = n_out5p0;
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out17p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:13
	float n_out13p0 = n_out17p0.x;
	float n_out13p1 = n_out17p0.y;
	float n_out13p2 = n_out17p0.z;


// FloatOp:16
	float n_in16p1 = 0.80000;
	float n_out16p0 = n_out13p2 + n_in16p1;


// VectorCompose:15
	vec3 n_out15p0 = vec3(n_out13p0, n_out13p1, n_out16p0);


	vec3 n_out14p0;
// ColorFunc:14
	{
		vec3 c = n_out15p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out14p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


	vec3 n_out11p0;
// If:11
	float n_in11p1 = 0.50000;
	float n_in11p2 = 0.01000;
	if(abs(n_out3p0.x - n_in11p1) < n_in11p2)
	{
		n_out11p0 = n_out14p0;
	}
	else if(n_out3p0.x < n_in11p1)
	{
		n_out11p0 = n_out5p0;
	}
	else
	{
		n_out11p0 = n_out5p0;
	}


	vec3 n_out12p0;
// If:12
	float n_in12p1 = 0.50000;
	float n_in12p2 = 0.01000;
	vec3 n_in12p4 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in12p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out3p0.x - n_in12p1) < n_in12p2)
	{
		n_out12p0 = n_out14p0;
	}
	else if(n_out3p0.x < n_in12p1)
	{
		n_out12p0 = n_in12p5;
	}
	else
	{
		n_out12p0 = n_in12p4;
	}


// Output:0
	ALBEDO = n_out11p0;
	EMISSION = n_out12p0;


}
